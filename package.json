{
  "name": "agent-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @agent-bridge/mock-apis --filter @agent-bridge/gateway --filter @agent-bridge/demo-web dev",
    "mcp:dev": "pnpm --filter @agent-bridge/mcp-server dev",
    "mcp:smoke": "pnpm --filter @agent-bridge/mcp-server smoke",
    "eval:router": "pnpm --filter @agent-bridge/gateway eval:router",
    "eval:router:cn": "pnpm --filter @agent-bridge/gateway eval:router ../../evals/cn-pension-router-cases.jsonl",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.7",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.7.0"
}
